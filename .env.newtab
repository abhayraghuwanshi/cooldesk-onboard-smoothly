# newtab (browser extension product). Overrides .env when building with
# `vite build --mode newtab`.
# TODO: not deployed yet — newtab.kazekit.com is a placeholder. Set the real
# canonical domain here (and in site.ts NEWTAB_URL) before launch.
VITE_SITE=newtab
VITE_TITLE=CoolDesk New Tab — A Project Workspace for Your Browser
VITE_DESCRIPTION=Replace your new tab with a project workspace. Group browser tabs, links and notes by project, with AI Spotlight search. Free Chrome extension — no sign-in required.
VITE_CANONICAL=https://newtab.kazekit.com/
VITE_SITE_NAME=CoolDesk New Tab
